# PostgreSQL read-only connection (nl2sql_readonly user)
# PostgreSQL local:
#   DATABASE_URL_READONLY=postgresql://nl2sql_readonly:PASSWORD@localhost:5432/your_database
# Supabase (ต้องมี ?sslmode=require, ดู connection string จาก Project Settings → Database):
#   DATABASE_URL_READONLY=postgresql://nl2sql_readonly:PASSWORD@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL_READONLY=postgresql://nl2sql_readonly:CHANGE_ME@localhost:5432/your_database

# MLX model path (Hugging Face ID or local path)
# ใช้ ../fused_model เมื่อ fuse โมเดล LoRA แล้ว (รันจาก api/)
MLX_MODEL_PATH=../fused_model
